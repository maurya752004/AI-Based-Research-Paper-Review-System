# Optional: set to enable OpenAI-powered review
OPENAI_API_KEY=

# If false, review endpoint returns error when LLM is unavailable
REVIEW_ALLOW_FALLBACK=true

# Optional: model fallback chain
MODEL_PRIMARY=gpt-4o-mini
MODEL_SECONDARY=gpt-4.1-mini

# Optional: override backend URL used by Streamlit
BACKEND_URL=http://localhost:8000

# Set false to disable login requirement (demo mode)
AUTH_REQUIRED=true

# Set false for fully free demo mode (no OpenAI API calls)
USE_OPENAI=true

# Local LLM settings (free)
USE_LOCAL_LLM=false
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: token settings
TOKEN_SECRET=change-me-in-production
TOKEN_TTL_SECONDS=43200

# Optional: override default users with JSON object
# Example:
# APP_USERS_JSON={"student1":{"password":"student123","role":"student"}}
APP_USERS_JSON=

# RAG vector store settings
RAG_DB_DIR=./rag_store

# Real-time paper feed settings
PAPER_FEED_QUERY=cat:cs.LG OR cat:cs.CL
PAPER_FEED_MAX_RESULTS=10
PAPER_FEED_HOUR_UTC=6
